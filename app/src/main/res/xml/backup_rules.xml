<?xml version="1.0" encoding="utf-8"?>
<!--
    ISSUE-043: backup rules for Auto Backup (used on API < 31 via
    android:fullBackupContent).

    The stores below hold sensitive, device-bound data and must NOT leave
    the device in a cloud backup:
    - kyawgyi_error_learning_memory.xml: error-learning history, blocked
      method keys and evidence notes (user's command history).
    - kyaw_gyi_secure_vault_prefs.xml / kyawgyi_keystore_vault.xml:
      Android-Keystore-wrapped vault material for the Gemini API key;
      wrapped blobs are keyed to THIS device's Keystore and must never be
      restored onto another device.
    - ai_angel_v25_db: the Room command-log database (command/failure
      history).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="kyawgyi_error_learning_memory.xml" />
    <exclude domain="sharedpref" path="kyaw_gyi_secure_vault_prefs.xml" />
    <exclude domain="sharedpref" path="kyawgyi_keystore_vault.xml" />
    <exclude domain="database" path="ai_angel_v25_db" />
</full-backup-content>
